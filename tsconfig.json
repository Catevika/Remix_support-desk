{
  "include": [ "remix.env.d.ts", "**/*.ts", "**/*.tsx", "server.js", "app/routes/board/employee/tickets/$ticketId/.deleteTicket.tsx" ],
  "compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2019"],
		"isolatedModules": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"target": "ES2019",
		"strict": true,
		"allowJs": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"~/*": ["./app/*"]
		},
		"noEmit": true
	}
}
